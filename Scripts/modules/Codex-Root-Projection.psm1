#Requires -Version 5.1
# Native discovery projection; Codex/.codex/AGENTS.md remains the source owner.
Import-Module (Join-Path $PSScriptRoot 'Deployment.Transaction.psm1') -ErrorAction Stop

function Assert-CodexRootProjectionTarget {
    param([Parameter(Mandatory=$true)][string]$TargetRoot)
    $root = Join-Path $TargetRoot 'AGENTS.md'
    $receipt = Join-Path $TargetRoot '.codex/ai-rules-root-agents.json'
    $override = Join-Path $TargetRoot 'AGENTS.override.md'
    foreach ($path in @($root, $receipt, $override)) {
        Assert-DeploymentPathUnlinked -Path $path
        if (Test-Path -LiteralPath $path -PathType Container) { throw "CodexRoot.NotFile: $path" }
    }
    if (Test-Path -LiteralPath $override) { throw 'CodexRoot.OverridePresent: preserve AGENTS.override.md; native root projection would be shadowed.' }
    $hasRoot = Test-Path -LiteralPath $root -PathType Leaf
    $hasReceipt = Test-Path -LiteralPath $receipt -PathType Leaf
    if (-not $hasRoot -and -not $hasReceipt) { return }
    if (-not $hasRoot -or -not $hasReceipt) { throw 'CodexRoot.UnownedOrIncomplete: preserve files; reconcile root and receipt explicitly.' }
    $state = Get-Content -LiteralPath $receipt -Raw -Encoding UTF8 -ErrorAction Stop | ConvertFrom-Json -ErrorAction Stop
    if ($state.schema_version -ne 1 -or $state.generator -cne 'AI_Rules.CodexRoot.v1' -or
        $state.target -cne 'AGENTS.md' -or $state.sha256 -cnotmatch '^[a-f0-9]{64}$' -or
        $state.sha256 -cne (Get-FileHash -LiteralPath $root -Algorithm SHA256).Hash.ToLowerInvariant()) {
        throw 'CodexRoot.ModifiedOrInvalidReceipt: preserve root and receipt; explicit conflict resolution required.'
    }
}

function Get-CodexRootProjectionArtifacts {
    param([Parameter(Mandatory=$true)][string]$Content)
    if ([string]::IsNullOrWhiteSpace($Content)) { throw 'CodexRoot.EmptySource' }
    $encoding = [Text.UTF8Encoding]::new($false)
    $header = '<!-- Generated by AI_Rules from the managed .codex/AGENTS.md projection. Do not edit this file; edit the canonical Codex template or the preserved PROJECT IDENTITY, then sync. -->'
    $bytes = $encoding.GetBytes($header + "`n`n" + $Content)
    $sha = [Security.Cryptography.SHA256]::Create()
    try { $hash = [BitConverter]::ToString($sha.ComputeHash($bytes)).Replace('-','').ToLowerInvariant() } finally { $sha.Dispose() }
    # Fixed fields and paths; the receipt never supplies a filesystem path to a writer.
    $receipt = '{"schema_version":1,"generator":"AI_Rules.CodexRoot.v1","target":"AGENTS.md","sha256":"' + $hash + '"}' + "`n"
    [pscustomobject]@{ RelativePath='AGENTS.md'; Bytes=[byte[]]$bytes }
    [pscustomobject]@{ RelativePath='.codex/ai-rules-root-agents.json'; Bytes=[byte[]]$encoding.GetBytes($receipt) }
}

function Sync-CodexRootProjection {
    param([Parameter(Mandatory=$true)][string]$TargetRoot)
    $ErrorActionPreference = 'Stop'
    Assert-CodexRootProjectionTarget -TargetRoot $TargetRoot
    $source = Join-Path $TargetRoot '.codex/AGENTS.md'
    Assert-DeploymentPathUnlinked -Path $source
    $content = Get-Content -LiteralPath $source -Raw -Encoding UTF8 -ErrorAction Stop
    $artifacts = @(Get-CodexRootProjectionArtifacts -Content $content)
    # Public callers also have an outer batch transaction. This nested transaction
    # keeps the root/receipt pair recoverable if either write itself fails.
    Invoke-DeploymentTransaction -TargetRoot $TargetRoot -AdditionalManagedPaths @('AGENTS.md') -Action {
        foreach ($artifact in $artifacts) {
            $path = Join-Path $TargetRoot $artifact.RelativePath
            if ((Test-Path -LiteralPath $path -PathType Leaf) -and
                [Convert]::ToBase64String([IO.File]::ReadAllBytes($path)) -ceq [Convert]::ToBase64String($artifact.Bytes)) { continue }
            [IO.File]::WriteAllBytes($path, $artifact.Bytes)
        }
    }
}

Export-ModuleMember -Function Assert-CodexRootProjectionTarget, Get-CodexRootProjectionArtifacts, Sync-CodexRootProjection
